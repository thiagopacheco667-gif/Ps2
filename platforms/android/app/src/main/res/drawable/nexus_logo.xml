<?xml version="1.0" encoding="utf-8"?>
<!-- Nexus2 in-app logo: the launcher mark on its own background, as one vector so Compose's
     painterResource can draw it (it cannot draw adaptive icons or layer-lists). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108">
                <item android:offset="0" android:color="#FF090B12" />
                <item android:offset="1" android:color="#FF141A27" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:pathData="M54,25 L79,39.5 L79,68.5 L54,83 L29,68.5 L29,39.5 Z"
        android:strokeWidth="4.5"
        android:strokeLineJoin="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="29" android:startY="25"
                android:endX="79" android:endY="83">
                <item android:offset="0" android:color="#FF8257FF" />
                <item android:offset="1" android:color="#FF35A8FF" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:pathData="M43,66 L43,42 L65,66 L65,42"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="43" android:startY="42"
                android:endX="65" android:endY="66">
                <item android:offset="0" android:color="#FFB39CFF" />
                <item android:offset="1" android:color="#FF8FD3FF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
